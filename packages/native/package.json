{
  "name": "@cue/native",
  "version": "0.0.0",
  "private": true,
  "main": "entry.ts",
  "description": "Cue's native app: the Expo / React Native client over @cue/core.",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit",
    "test": "EXPO_PUBLIC_TRAKT_CLIENT_ID=test-client jest",
    "eas-build-post-install": ": \"${EXPO_PUBLIC_TRAKT_CLIENT_ID:?the app throws at startup without a Trakt client id}\""
  },
  "dependencies": {
    "@cue/core": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "57.0.26",
    "@tanstack/query-async-storage-persister": "5.101.2",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "5.101.2",
    "expo": "57.0.31",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-notifications": "57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "catalog:",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
