[
  {
    "name": "web initial load",
    "path": [
      "packages/web/dist/assets/index-*.js",
      "packages/web/dist/assets/useDocumentTitle-*.js",
      "packages/web/dist/assets/query-keys-*.js",
      "packages/web/dist/assets/query-freshness-*.js",
      "packages/web/dist/assets/index-*.css"
    ],
    "limit": "170 kB"
  },
  {
    "name": "web all JavaScript and CSS",
    "path": "packages/web/dist/**/*.{js,css}",
    "limit": "285 kB"
  },
  {
    "name": "expo iOS bundle",
    "path": "packages/native/dist/_expo/static/js/ios/entry-*.hbc",
    "brotli": false,
    "limit": "4450 kB"
  },
  {
    "name": "expo Android bundle",
    "path": "packages/native/dist/_expo/static/js/android/entry-*.hbc",
    "brotli": false,
    "limit": "4830 kB"
  }
]
