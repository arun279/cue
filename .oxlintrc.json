{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Biome owns every other lint rule; it has no cyclomatic complexity rule and
  // no way to forbid TypeScript or complexity suppressions.
  "categories": { "correctness": "off" },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "rules": {
    // Biome's import organizer merges imports of one module but keeps a type-only
    // import apart from a value import of the same module.
    "import/no-duplicates": ["error", { "preferInline": true }],
    // McCabe's limit of 10, as recommended by NIST SP 500-235 (Watson and
    // McCabe, 1996), section 2.5.
    "complexity": ["error", { "max": 10 }],
    "typescript/ban-ts-comment": [
      "error",
      { "ts-expect-error": true, "ts-ignore": true, "ts-nocheck": true }
    ],
    "no-warning-comments": [
      "error",
      {
        "terms": [
          "oxlint-disable",
          "eslint-disable",
          "lint/complexity/noExcessiveCognitiveComplexity"
        ],
        "location": "anywhere"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["msw", "msw/*"],
            "message": "Tests reach Trakt through the fake in test/core/trakt-fake, not their own MSW handlers."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/core/trakt-fake/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // React Native 0.86 polyfills AbortController with abort-controller 3.0.0, which
      // predates these (facebook/react-native#55247). Node has them, so tests pass and
      // the app throws.
      "files": ["app/**", "modules/**", "src/**"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "AbortSignal",
            "property": "timeout",
            "message": "Not in React Native 0.86. Use withDeadline from src/core/domain/abortable.ts."
          },
          {
            "object": "AbortSignal",
            "property": "any",
            "message": "Not in React Native 0.86. Forward the abort event to one AbortController."
          },
          {
            "object": "AbortSignal",
            "property": "abort",
            "message": "Not in React Native 0.86. Call abort() on an AbortController."
          },
          {
            "property": "throwIfAborted",
            "message": "Not in React Native 0.86. Check signal.aborted."
          },
          {
            "property": "reason",
            "message": "AbortSignal has no reason in React Native 0.86, so it reads as undefined."
          }
        ]
      }
    }
  ]
}
