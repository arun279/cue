require "tmpdir"
require "tempfile"

# Cue release automation.
#
# iOS has tester and production lanes; Android ships only to Firebase testers:
#   ios beta         -> Capacitor build for TestFlight internal testers
#   ios expo_beta    -> Expo build for TestFlight internal testers
#   ios release      -> Capacitor build for App Store review + auto-release
#   android beta      -> Capacitor build for Firebase App Distribution
#   android expo_beta -> Expo build for Firebase App Distribution
#
# Build numbers come from BUILD_NUMBER (CI combines github.run_number and
# github.run_attempt) so every upload is unique and strictly increasing. The
# marketing version comes from APP_VERSION on releases and otherwise stays at
# the native default. All signing material and distribution credentials are
# injected via environment variables from CI secrets; nothing sensitive lives
# in the repo.
#
# The web bundle must already be built (`pnpm build`) and synced into the native
# projects (`pnpm exec cap sync <platform>`) before these lanes run; CI does that.

REPO_ROOT = File.expand_path("..", __dir__).freeze
APP_IDENTIFIER = "app.cuetracker".freeze
IOS_PROJECT = "ios/App/App.xcodeproj".freeze
IOS_SCHEME = "App".freeze
EXPO_IOS_PROJECT = "packages/native/ios/Cue.xcodeproj".freeze
EXPO_IOS_WORKSPACE = "packages/native/ios/Cue.xcworkspace".freeze
EXPO_IOS_SCHEME = "Cue".freeze
EXPO_IOS_IPA = "build/ios/Cue.ipa".freeze
ANDROID_DIR = "android".freeze
ANDROID_APK = "android/app/build/outputs/apk/release/app-release.apk".freeze
EXPO_ANDROID_DIR = "packages/native/android".freeze
EXPO_ANDROID_AAB = "packages/native/android/app/build/outputs/bundle/release/app-release.aab".freeze
EXPO_ANDROID_APKS = "packages/native/android/app/build/outputs/bundle/release/app-release.apks".freeze
EXPO_ANDROID_APK = "packages/native/android/app/build/outputs/bundle/release/universal.apk".freeze
FIREBASE_ANDROID_APP = "1:768077963989:android:2f55dce37b989717ca785c".freeze
VERIFY_APK = "scripts/verify-apk.sh".freeze
ASSERT_FILE_SIZE = "scripts/assert-file-size.mjs".freeze

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
    is_key_content_base64: true
  )
end

def app_version
  version = ENV["APP_VERSION"].to_s
  version.empty? ? "1.0" : version
end

def build_number
  Integer(ENV.fetch("BUILD_NUMBER"))
end

def build_ios_ipa
  install_provisioning_profile(path: ENV.fetch("PROVISIONING_PROFILE_PATH"))
  update_code_signing_settings(
    use_automatic_signing: false,
    team_id: ENV.fetch("IOS_TEAM_ID"),
    profile_name: ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"),
    code_sign_identity: "Apple Distribution",
    targets: ["App"],
    path: IOS_PROJECT,
    build_configurations: ["Release"]
  )
  build_app(
    project: IOS_PROJECT,
    scheme: IOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build/ios",
    output_name: "App.ipa",
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number} MARKETING_VERSION=#{app_version}",
    export_options: {
      signingStyle: "manual",
      teamID: ENV.fetch("IOS_TEAM_ID"),
      provisioningProfiles: {APP_IDENTIFIER => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")}
    }
  )
  sh(
    "node",
    File.join(REPO_ROOT, ASSERT_FILE_SIZE),
    File.join(REPO_ROOT, "build/ios/App.ipa"),
    ENV.fetch("IPA_SIZE_LIMIT_BYTES"),
    "IPA"
  )
end

def verify_ipa_version(ipa_path)
  Dir.mktmpdir("cue-ipa") do |directory|
    sh("unzip", "-q", ipa_path, "-d", directory)
    info_plist = Dir.glob(File.join(directory, "Payload", "*.app", "Info.plist")).first
    UI.user_error!("IPA does not contain an application Info.plist") if info_plist.nil?

    actual_build = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleVersion", info_plist).strip
    actual_version = sh("/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString", info_plist).strip
    UI.user_error!("IPA build number #{actual_build} does not match #{build_number}") unless actual_build == build_number.to_s
    UI.user_error!("IPA version #{actual_version} does not match #{app_version}") unless actual_version == app_version
  end
end

def ensure_testflight_build_number_available(api_key)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    version: app_version,
    initial_build_number: 0
  )
  return if build_number > latest

  UI.user_error!("BUILD_NUMBER #{build_number} must be greater than TestFlight build #{latest}")
end

def build_expo_ios_ipa
  install_provisioning_profile(path: ENV.fetch("PROVISIONING_PROFILE_PATH"))
  update_code_signing_settings(
    use_automatic_signing: false,
    team_id: ENV.fetch("IOS_TEAM_ID"),
    profile_name: ENV.fetch("IOS_PROVISIONING_PROFILE_NAME"),
    code_sign_identity: "Apple Distribution",
    targets: [EXPO_IOS_SCHEME],
    path: EXPO_IOS_PROJECT,
    build_configurations: ["Release"]
  )
  build_app(
    workspace: EXPO_IOS_WORKSPACE,
    scheme: EXPO_IOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build/ios",
    output_name: "Cue.ipa",
    export_options: {
      signingStyle: "manual",
      teamID: ENV.fetch("IOS_TEAM_ID"),
      provisioningProfiles: {APP_IDENTIFIER => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME")}
    }
  )
  verify_ipa_version(EXPO_IOS_IPA)
  sh(
    "node",
    File.join(REPO_ROOT, ASSERT_FILE_SIZE),
    File.join(REPO_ROOT, EXPO_IOS_IPA),
    ENV.fetch("IPA_SIZE_LIMIT_BYTES"),
    "IPA"
  )
end

platform :ios do
  desc "Build a signed IPA and ship to TestFlight (no review after the first build)"
  lane :beta do
    key = asc_api_key
    build_ios_ipa
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build the Expo app and ship it to TestFlight internal testers"
  lane :expo_beta do
    key = asc_api_key
    build_expo_ios_ipa
    ensure_testflight_build_number_available(key)
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build a signed IPA and submit to the App Store (auto-release on approval)"
  lane :release do
    # The first submission requires the app record, metadata, screenshots, and
    # age rating to exist in App Store Connect before this lane can submit it.
    key = asc_api_key
    build_ios_ipa
    upload_to_app_store(
      api_key: key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      skip_metadata: true,
      skip_screenshots: true,
      submission_information: {add_id_info_uses_idfa: false}
    )
  end
end

def build_android_apk
  gradle(
    project_dir: ANDROID_DIR,
    task: "assemble",
    build_type: "Release",
    properties: {
      "cueVersionCode" => build_number,
      "cueVersionName" => app_version
    }
  )
  verify_android_apk
end

# android/app/build.gradle is Capacitor-generated, so regenerating the platform
# would drop the version wiring and quietly ship every build as 1.0 (1) again.
# The same read pins the permission set the phone shows a tester, which is a
# merge result no repo file can be checked for: any dependency's manifest can
# add to it.
def verify_android_apk
  sh(
    File.join(REPO_ROOT, VERIFY_APK),
    File.join(REPO_ROOT, ANDROID_APK),
    build_number.to_s,
    app_version
  )
end

def build_expo_android_apk
  gradle(
    project_dir: EXPO_ANDROID_DIR,
    task: "bundle",
    build_type: "Release"
  )
  Tempfile.create("cue-keystore-password") do |keystore_password|
    Tempfile.create("cue-key-password") do |key_password|
      keystore_password.write(ENV.fetch("ANDROID_KEYSTORE_PASSWORD"))
      keystore_password.flush
      key_password.write(ENV.fetch("ANDROID_KEY_PASSWORD"))
      key_password.flush
      sh(
        "java",
        "-jar",
        ENV.fetch("BUNDLETOOL_PATH"),
        "build-apks",
        "--bundle=#{File.join(REPO_ROOT, EXPO_ANDROID_AAB)}",
        "--output=#{File.join(REPO_ROOT, EXPO_ANDROID_APKS)}",
        "--mode=universal",
        "--ks=#{ENV.fetch("ANDROID_KEYSTORE_PATH")}",
        "--ks-pass=file:#{keystore_password.path}",
        "--ks-key-alias=#{ENV.fetch("ANDROID_KEY_ALIAS")}",
        "--key-pass=file:#{key_password.path}"
      )
    end
  end
  sh(
    "unzip",
    "-o",
    File.join(REPO_ROOT, EXPO_ANDROID_APKS),
    "universal.apk",
    "-d",
    File.dirname(File.join(REPO_ROOT, EXPO_ANDROID_APK))
  )
  sh(
    File.join(REPO_ROOT, VERIFY_APK),
    File.join(REPO_ROOT, EXPO_ANDROID_APK),
    build_number.to_s,
    app_version,
    "expo"
  )
end

def ensure_firebase_build_number_available
  latest = firebase_app_distribution_get_latest_release(
    app: FIREBASE_ANDROID_APP,
    service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON")
  )
  latest_build_number = latest[:buildVersion].to_i
  return if build_number > latest_build_number

  UI.user_error!("BUILD_NUMBER #{build_number} must be greater than Firebase build #{latest_build_number}")
end

def distribute_android_apk(apk_path)
  firebase_app_distribution(
    app: FIREBASE_ANDROID_APP,
    groups: "friends",
    android_artifact_type: "APK",
    android_artifact_path: apk_path,
    service_credentials_json_data: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_JSON")
  )
end

platform :android do
  desc "Build a signed APK and ship to Firebase App Distribution testers"
  lane :beta do
    build_android_apk
    distribute_android_apk(ANDROID_APK)
  end

  desc "Build the Expo app and ship it to Firebase App Distribution testers"
  lane :expo_beta do
    build_expo_android_apk
    ensure_firebase_build_number_available
    distribute_android_apk(EXPO_ANDROID_APK)
  end
end
