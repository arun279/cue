# Cue release automation.
#
# Two platforms, two lanes each:
#   beta    -> testers      (TestFlight internal group / Play internal track)
#   release -> production   (App Store review + auto-release / Play production)
#
# Build numbers come from BUILD_NUMBER (CI passes github.run_number) so every
# upload is unique and strictly increasing, which both stores require. The
# marketing version comes from APP_VERSION (CI passes the git tag on releases,
# empty otherwise). All signing material and store credentials are injected via
# environment variables from CI secrets; nothing sensitive lives in the repo.
#
# The web bundle must already be built (`pnpm build`) and synced into the native
# projects (`npx cap sync <platform>`) before these lanes run; CI does that.

APP_IDENTIFIER = "app.cuetracker".freeze
IOS_PROJECT = "ios/App/App.xcodeproj".freeze
IOS_SCHEME = "App".freeze
ANDROID_DIR = "android".freeze
ANDROID_AAB = "android/app/build/outputs/bundle/release/app-release.aab".freeze

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: ENV.fetch("APP_STORE_CONNECT_KEY"),
    is_key_content_base64: true,
  )
end

def build_ios_ipa
  increment_build_number(
    xcodeproj: IOS_PROJECT,
    build_number: ENV.fetch("BUILD_NUMBER"),
  )
  version = ENV["APP_VERSION"].to_s
  increment_version_number(xcodeproj: IOS_PROJECT, version_number: version) unless version.empty?
  build_app(
    project: IOS_PROJECT,
    scheme: IOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    output_directory: "build/ios",
    output_name: "App.ipa",
    export_options: {
      signingStyle: "manual",
      provisioningProfiles: { APP_IDENTIFIER => ENV.fetch("IOS_PROVISIONING_PROFILE_NAME") },
    },
  )
end

platform :ios do
  desc "Build a signed IPA and ship to TestFlight (no review after the first build)"
  lane :beta do
    key = asc_api_key
    build_ios_ipa
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end

  desc "Build a signed IPA and submit to the App Store (auto-release on approval)"
  lane :release do
    key = asc_api_key
    build_ios_ipa
    upload_to_app_store(
      api_key: key,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      run_precheck_before_submit: false,
      skip_metadata: true,
      skip_screenshots: true,
      submission_information: { add_id_info_uses_idfa: false },
    )
  end
end

def build_android_aab
  gradle(
    project_dir: ANDROID_DIR,
    task: "bundle",
    build_type: "Release",
    properties: {
      "android.injected.version.code" => Integer(ENV.fetch("BUILD_NUMBER")),
      "android.injected.version.name" => (ENV["APP_VERSION"].to_s.empty? ? "1.0" : ENV["APP_VERSION"]),
    },
  )
end

platform :android do
  desc "Build a signed AAB and ship to the Play internal track (no review)"
  lane :beta do
    build_android_aab
    upload_to_play_store(
      track: "internal",
      aab: ANDROID_AAB,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed",
    )
  end

  desc "Build a signed AAB and promote to Play production (staged 20% rollout)"
  lane :release do
    build_android_aab
    upload_to_play_store(
      track: "production",
      aab: ANDROID_AAB,
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "inProgress",
      rollout: "0.2",
    )
  end
end
