<?xml version="1.0" encoding="utf-8" ?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Cue's app storage holds a live Trakt refresh token and a cache that is
        rebuildable from Trakt in one sync, so there is nothing here worth
        restoring and one thing worth never copying. allowBackup="false" stops
        Google Drive backup and `adb backup` on every version; it does not stop
        device-to-device transfer on Android 12+, which is what the exclusions in
        @xml/data_extraction_rules are for. No fullBackupContent: it only applies
        where allowBackup="false" already blocks everything unconditionally.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        The local-notifications plugin declares SCHEDULE_EXACT_ALARM in its own
        manifest, and the merger would hand it to app.cuetracker. Cue never asks
        for an exact alarm: every reminder is scheduled with
        isExactNotification: false, so the plugin uses setAndAllowWhileIdle,
        which is what Android's own guidance prescribes for a user-specified
        time that may fall during Doze. Keeping the declaration would put an
        "Alarms & reminders" entry in system settings for a permission the app
        never uses, and the auto-granted alternative, USE_EXACT_ALARM, is
        restricted by Play policy to alarm, timer and calendar apps. Remove it.
        POST_NOTIFICATIONS, RECEIVE_BOOT_COMPLETED and WAKE_LOCK still merge in
        from the same plugin and are all load-bearing: the runtime permission
        from API 33, the reboot rescheduling that AlarmManager makes necessary,
        and the alarm receiver's wake lock.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
