<?xml version="1.0" encoding="utf-8"?>
<!--
    Every storage domain the platform can name, excluded from both channels.
    Cue keeps a Trakt refresh token in shared preferences and a Trakt cache
    under the WebView directory; neither belongs in a Google account, and
    neither is worth carrying to a new phone when one device code signs back
    in. The device-protected domains are listed even though nothing writes to
    them today, so moving a store behind a device-protected context stays
    covered instead of quietly opting back in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
