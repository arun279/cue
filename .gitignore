# Dependencies
node_modules/

# Build output
dist/
*.ipa
*.tsbuildinfo

# Generated by `expo prebuild` and the native typecheck; native changes live in config plugins.
packages/native/ios/
packages/native/android/
packages/native/.expo/
# The local Expo module is source; what Gradle leaves beside it is not.
packages/native/modules/*/android/build/
packages/native/modules/*/android/.cxx/

# Env files carry a developer's own Trakt client id.
.env*
*.local
*.pem
*.key
# Mobile signing material (Android keystore / iOS provisioning) and misc secrets
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.secret
secrets/
# Testing
coverage/
.dprint-cache
.pnpm-store/

# Editor / OS
.DS_Store
*.swp

# Logs
*.log

/packages/native/credentials.json
