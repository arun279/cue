# Dependencies
node_modules/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Capacitor native projects (generated by `cap add`; regenerated from src/ + dist)
ios/
android/
.wrangler/

# Env / secrets — Trakt client_id/secret and TMDB key are entered at runtime, never committed
.env*
!.env.example
*.local
*.pem
*.key
# Mobile signing material (Android keystore / iOS provisioning) and misc secrets
*.keystore
*.p12
*.mobileprovision
*.secret
secrets/

# Testing
coverage/
playwright-report/
test-results/
.dprint-cache

# Local design-review output (screenshots + notes). Never push.
design-review/

# Playwright MCP scratch output (console logs + snapshots) from local UI runs.
.playwright-mcp/

# Editor / OS
.DS_Store
*.swp

# Logs
*.log
