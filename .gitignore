# Dependencies
node_modules/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Capacitor native projects (generated by `cap add`; regenerated from src/ + dist)
ios/
android/
.wrangler/

# Env — the real .env (your Trakt app's PUBLIC client id) is local-only.
# Committed: .env.example (placeholders) + .env.test (CI/e2e dummy id).
.env*
!.env.example
!.env.test
*.local
*.pem
*.key
# Mobile signing material (Android keystore / iOS provisioning) and misc secrets
*.keystore
*.p12
*.mobileprovision
*.secret
secrets/

# Testing
coverage/
playwright-report/
test-results/
.dprint-cache

# Local design-review output (screenshots + notes). Never push.
design-review/

# Playwright MCP scratch output (console logs + snapshots) from local UI runs.
.playwright-mcp/

# Editor / OS
.DS_Store
*.swp

# Logs
*.log
