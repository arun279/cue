# Dependencies
node_modules/

# Build output
dist/
dev-dist/
*.tsbuildinfo

# Capacitor native projects are committed. Their nested ios/.gitignore and
# android/.gitignore exclude build outputs (Pods, .gradle, build/, DerivedData)
# and the web assets copied from dist/ by `cap sync`; signing material stays out
# via the patterns below.
.wrangler/

# Env: the real .env (your Trakt app's PUBLIC client id) is local-only.
# Committed: .env.example (placeholders) + .env.test (CI/e2e dummy id).
.env*
!.env.example
!.env.test
*.local
*.pem
*.key
# Mobile signing material (Android keystore / iOS provisioning) and misc secrets
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.secret
secrets/
# Android signing passwords injected into Gradle at build time (never commit)
android/keystore.properties

# Testing
coverage/
playwright-report/
test-results/
.dprint-cache

# Local design-review output (screenshots + notes). Never push.
design-review/

# Playwright MCP scratch output (console logs + snapshots) from local UI runs.
.playwright-mcp/

# Editor / OS
.DS_Store
*.swp

# Logs
*.log
