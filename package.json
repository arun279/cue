{
  "name": "cue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cue: a Trakt-backed Up Next queue for iOS and Android.",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @cue/native start",
    "fake:trakt": "node packages/core/test/trakt-fake/serve.ts",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "format": "biome check --write . && dprint fmt",
    "test": "vitest run",
    "test:native": "pnpm --filter @cue/native test",
    "test:watch": "vitest",
    "check:spell": "cspell --no-progress --no-summary",
    "check:arch": "depcruise packages --config .dependency-cruiser.cjs",
    "check:core-portable": "vitest run --project core test/ci/core-portable.test.ts",
    "check:deps": "pnpm --filter @cue/native exec expo install --check",
    "check:bundle": "EXPO_ATLAS=true pnpm --filter @cue/native exec expo export --platform ios --platform android --output-dir dist && node scripts/check-shipped-modules.mjs && node scripts/check-store-bundle.mjs",
    "check": "biome check --error-on-warnings . && oxlint && dprint check && pnpm check:spell && pnpm typecheck && pnpm check:deps && pnpm check:arch && knip && jscpd && pnpm check:bundle && vitest run && pnpm test:native",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/node": "catalog:",
    "cspell": "^9.8.0",
    "dependency-cruiser": "^18.0.0",
    "dprint": "^0.55.1",
    "jscpd": "^5.0.11",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "oxlint": "^1.88.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.9.0 <0.9.12": ">=0.9.12",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<=4.28.6": ">=4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "zod@<4.6.6": "^4.6.6"
    },
    "patchedDependencies": {
      "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch",
      "expo-modules-core@57.0.24": "patches/expo-modules-core@57.0.24.patch"
    }
  }
}
