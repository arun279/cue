{
  "name": "cue",
  "version": "0.0.0",
  "private": true,
  "description": "Cue: a Trakt-backed Up Next queue for iOS and Android.",
  "main": "entry.ts",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "expo start",
    "fake:trakt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON test/core/trakt-fake/serve.ts",
    "typecheck": "expo customize tsconfig.json && tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p test && tsc --noEmit -p test/core",
    "format": "biome check --write . && dprint fmt",
    "test": "vitest run",
    "test:native": "EXPO_PUBLIC_TRAKT_CLIENT_ID=test-client jest",
    "test:watch": "vitest",
    "check:spell": "cspell --no-progress --no-summary",
    "check:arch": "depcruise . --config .dependency-cruiser.cjs",
    "check:deps": "expo install --check",
    "check:bundle": "EXPO_ATLAS=true expo export --platform ios --platform android --output-dir dist && node scripts/check-shipped-modules.mjs && node scripts/check-store-bundle.mjs",
    "check": "biome check --error-on-warnings . && oxlint && dprint check && pnpm check:spell && pnpm typecheck && pnpm check:deps && pnpm check:arch && knip && jscpd && pnpm check:bundle && vitest run && pnpm test:native",
    "prepare": "lefthook install",
    "eas-build-post-install": ": \"${EXPO_PUBLIC_TRAKT_CLIENT_ID:?the app throws at startup without a Trakt client id}\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.17",
    "@expo/ui": "57.0.26",
    "@tanstack/query-async-storage-persister": "5.101.2",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-query-persist-client": "5.101.2",
    "expo": "57.0.31",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-notifications": "57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "^19.2.7",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.6",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@expo/fingerprint": "0.20.14",
    "@expo/repack-app": "0.10.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^22.12.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-preset-expo": "~57.0.7",
    "cspell": "^9.8.0",
    "dependency-cruiser": "^18.0.0",
    "dprint": "^0.55.1",
    "eas-cli": "24.10.0",
    "expo-atlas": "0.5.0",
    "fast-check": "^4.10.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "jscpd": "^5.0.11",
    "jsdom": "^29.1.1",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "msw": "^2.14.6",
    "oxlint": "^1.88.0",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.9.0 <0.9.12": ">=0.9.12",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<=4.28.6": ">=4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "zod@<4.6.6": "^4.6.6"
    },
    "patchedDependencies": {
      "react-native-screens@4.26.2": "patches/react-native-screens@4.26.2.patch",
      "expo-modules-core@57.0.24": "patches/expo-modules-core@57.0.24.patch"
    }
  }
}
