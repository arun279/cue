{
  "name": "cue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cue: a Trakt-backed Up Next queue for iOS and Android.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @cue/native start",
    "mock:trakt": "node scripts/mock-trakt/server.mjs",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write . && dprint fmt",
    "test": "vitest run",
    "test:native": "pnpm --filter @cue/native test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:md": "dprint check",
    "check:spell": "cspell --no-progress --no-summary \"**/*.{ts,tsx,css,md}\"",
    "check:arch": "depcruise packages --config .dependency-cruiser.cjs",
    "check:knip": "knip",
    "check:dup": "jscpd",
    "check:core-portable": "vitest run --project core test/ci/core-portable.test.ts",
    "check:render-counts": "node scripts/check-render-counts.mjs packages/native/.reassure/baseline.perf packages/native/.reassure/current.perf",
    "check:size:native": "pnpm --filter @cue/native exec expo export --platform ios --platform android --output-dir dist && node scripts/check-native-assets.mjs",
    "check:quality-budget": "node scripts/check-quality-budget.mjs",
    "check:type-suppressions": "node scripts/check-type-suppressions.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "buster:check": "node scripts/write-buster.mjs --check",
    "buster:bump": "node scripts/write-buster.mjs --bump",
    "check": "pnpm check:node && biome check --error-on-warnings . && dprint check && pnpm check:spell && pnpm typecheck && pnpm check:arch && knip && jscpd && pnpm check:quality-budget && pnpm check:type-suppressions && pnpm buster:check && pnpm check:size:native && vitest run --coverage && pnpm test:native",
    "audit": "pnpm audit --prod --audit-level=high",
    "preinstall": "node scripts/check-node-version.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@expo/fingerprint": "0.20.9",
    "@expo/metro-config": "57.0.9",
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cspell": "^9.8.0",
    "dependency-cruiser": "^18.0.0",
    "dprint": "^0.55.1",
    "expo-atlas": "0.4.3",
    "jscpd": "^5.0.11",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@>=0.9.0 <0.9.12": ">=0.9.12",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "browserslist@<=4.28.6": ">=4.28.7",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18"
    },
    "patchedDependencies": {
      "@expo/metro-config@57.0.9": "patches/@expo__metro-config@57.0.9.patch"
    }
  }
}
