{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.mjs", "plugins/*.js"],
  "project": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "modules/**/*.ts",
    "plugins/*.js",
    "scripts/**/*.mjs",
    "test/**/*.{ts,tsx}",
    "__tests__/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": ["expo-atlas"],
  "babel": ["babel.config.js"]
}
