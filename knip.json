{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["defaults"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/mock-trakt/*.mjs"],
      "project": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["@capacitor/android", "@capacitor/ios", "expo-atlas"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "test/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/native": {
      "entry": ["plugins/*.js"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "modules/**/*.ts", "plugins/*.js"],
      "babel": ["babel.config.js"]
    }
  }
}
