{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["defaults"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/mock-trakt/*.mjs"],
      "project": ["scripts/**/*.mjs", "*.ts"],
      "ignoreDependencies": ["expo-atlas"]
    },
    "packages/core": {
      "project": ["src/**/*.ts", "test/**/*.{ts,tsx}"],
      "paths": {
        "@ui/*": ["../web/src/ui/*"],
        "@app/*": ["../web/src/app/*"],
        "@platform/*": ["../web/src/platform/*"]
      },
      "includeEntryExports": true
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/native": {
      "entry": ["plugins/*.js"],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "modules/**/*.ts", "plugins/*.js"],
      "babel": ["babel.config.js"]
    }
  }
}
