{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["defaults"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/mock-trakt/*.mjs"],
      "project": ["scripts/**/*.mjs", "*.ts"]
    },
    "packages/web": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    }
  }
}
